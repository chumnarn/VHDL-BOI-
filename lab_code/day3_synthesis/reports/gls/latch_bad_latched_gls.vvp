#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5c0504f9a140 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5c0504f9a2d0 .scope module, "tb_latch_bad" "tb_latch_bad" 3 6;
 .timescale -9 -12;
v0x5c0504faffe0_0 .var "d", 0 0;
v0x5c0504fb0080_0 .var "e", 0 0;
v0x5c0504fb0120_0 .var/i "errors", 31 0;
v0x5c0504fb01c0_0 .net "q", 0 0, L_0x5c0504fb0380;  1 drivers
S_0x5c0504f60500 .scope module, "dut" "latch_bad" 3 13, 4 3 0, S_0x5c0504f9a2d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "d";
    .port_info 1 /INPUT 1 "e";
    .port_info 2 /OUTPUT 1 "q";
L_0x5c0504fb0290 .functor BUFZ 1, v0x5c0504faffe0_0, C4<0>, C4<0>, C4<0>;
L_0x5c0504fb0380 .functor BUFZ 1, v0x5c0504faffe0_0, C4<0>, C4<0>, C4<0>;
L_0x5c0504fb0440 .functor BUFZ 1, v0x5c0504faffe0_0, C4<0>, C4<0>, C4<0>;
v0x5c0504f60730_0 .net "d", 0 0, v0x5c0504faffe0_0;  1 drivers
v0x5c0504fafc30_0 .net "e", 0 0, v0x5c0504fb0080_0;  1 drivers
v0x5c0504fafcf0_0 .net "n5_q", 0 0, L_0x5c0504fb0290;  1 drivers
v0x5c0504fafd90_0 .net "q", 0 0, L_0x5c0504fb0380;  alias, 1 drivers
v0x5c0504fafe50_0 .net "s", 0 0, L_0x5c0504fb0440;  1 drivers
    .scope S_0x5c0504f9a2d0;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c0504faffe0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c0504fb0080_0, 0, 1;
    %end;
    .thread T_0, $init;
    .scope S_0x5c0504f9a2d0;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5c0504fb0120_0, 0, 32;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5c0504fb0080_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5c0504faffe0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x5c0504fb01c0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_1.0, 6;
    %load/vec4 v0x5c0504fb0120_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5c0504fb0120_0, 0, 32;
    %vpi_call/w 3 22 "$display", "FAIL phase1: latch should follow d=1, got q=%b", v0x5c0504fb01c0_0 {0 0 0};
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c0504fb0080_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c0504faffe0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x5c0504fb01c0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_1.2, 6;
    %load/vec4 v0x5c0504fb0120_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5c0504fb0120_0, 0, 32;
    %vpi_call/w 3 29 "$display", "FAIL phase2: latch should HOLD 1 after e=0, got q=%b", v0x5c0504fb01c0_0 {0 0 0};
T_1.2 ;
    %vpi_call/w 3 32 "$display", "GLS tb_latch_bad: errors = %0d", v0x5c0504fb0120_0 {0 0 0};
    %load/vec4 v0x5c0504fb0120_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_1.4, 4;
    %vpi_call/w 3 34 "$display", "GLS RESULT: PASS" {0 0 0};
    %jmp T_1.5;
T_1.4 ;
    %vpi_call/w 3 36 "$display", "GLS RESULT: FAIL" {0 0 0};
T_1.5 ;
    %vpi_call/w 3 37 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_latch_bad.v";
    "build/latch_bad_latched_generic.v";
