#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x615ef1400a50 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x615ef1400be0 .scope module, "tb_latch_ok" "tb_latch_ok" 3 5;
 .timescale -9 -12;
v0x615ef14160b0_0 .var "d", 0 0;
v0x615ef1416180_0 .var "e", 0 0;
v0x615ef1416250_0 .var/i "errors", 31 0;
v0x615ef1416320_0 .net "q", 0 0, v0x615ef1415f90_0;  1 drivers
S_0x615ef13c7500 .scope module, "dut" "latch_ok" 3 12, 4 3 0, S_0x615ef1400be0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "d";
    .port_info 1 /INPUT 1 "e";
    .port_info 2 /OUTPUT 1 "q";
v0x615ef13c7730_0 .net "d", 0 0, v0x615ef14160b0_0;  1 drivers
v0x615ef1415ed0_0 .net "e", 0 0, v0x615ef1416180_0;  1 drivers
v0x615ef1415f90_0 .var "q", 0 0;
E_0x615ef1401e60 .event anyedge, v0x615ef1415ed0_0, v0x615ef13c7730_0;
    .scope S_0x615ef13c7500;
T_0 ;
    %wait E_0x615ef1401e60;
    %load/vec4 v0x615ef1415ed0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x615ef13c7730_0;
    %store/vec4 v0x615ef1415f90_0, 0, 1;
T_0.0 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x615ef1400be0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x615ef14160b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x615ef1416180_0, 0, 1;
    %end;
    .thread T_1, $init;
    .scope S_0x615ef1400be0;
T_2 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x615ef1416250_0, 0, 32;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x615ef1416180_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x615ef14160b0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x615ef1416320_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.0, 6;
    %load/vec4 v0x615ef1416250_0;
    %addi 1, 0, 32;
    %store/vec4 v0x615ef1416250_0, 0, 32;
    %vpi_call/w 3 20 "$display", "FAIL phase1: latch should follow d=1, got q=%b", v0x615ef1416320_0 {0 0 0};
T_2.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x615ef1416180_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x615ef14160b0_0, 0, 1;
    %delay 1000, 0;
    %load/vec4 v0x615ef1416320_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.2, 6;
    %load/vec4 v0x615ef1416250_0;
    %addi 1, 0, 32;
    %store/vec4 v0x615ef1416250_0, 0, 32;
    %vpi_call/w 3 26 "$display", "FAIL phase2: latch should HOLD 1 after e=0, got q=%b", v0x615ef1416320_0 {0 0 0};
T_2.2 ;
    %vpi_call/w 3 29 "$display", "GLS tb_latch_ok: errors = %0d", v0x615ef1416250_0 {0 0 0};
    %load/vec4 v0x615ef1416250_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.4, 4;
    %vpi_call/w 3 31 "$display", "GLS RESULT: PASS" {0 0 0};
    %jmp T_2.5;
T_2.4 ;
    %vpi_call/w 3 33 "$display", "GLS RESULT: FAIL" {0 0 0};
T_2.5 ;
    %vpi_call/w 3 34 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_latch_ok.v";
    "build/latch_ok_generic.v";
